            "state": "translated",
            "value": "SponsorBlock"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "Subscribe": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnieren"
          }
        }
      }
    },
    "Subscriptions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos"
          }
        }
      }
    },
    "Subscriptions, History, Watch Later and settings are kept on this Apple TV and on your household's own sync server. No account, no other server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, Verlauf, „Später ansehen“ und Einstellungen liegen auf diesem Apple TV und auf dem eigenen Sync-Server deines Haushalts. Kein Konto, kein anderer Server."
          }
        }
      }
    },
    "Subscriptions, History, Watch Later and settings stay on this Apple TV. No account, no server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, Verlauf, „Später ansehen“ und Einstellungen bleiben auf diesem Apple TV. Kein Konto, kein Server."
          }
        }
      }
    },
    "Subscriptions, Watch Later, History and SponsorBlock settings sync with your household's own server, %@. Nothing goes anywhere else.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, „Später ansehen“, Verlauf und SponsorBlock-Einstellungen werden mit dem eigenen Server deines Haushalts synchronisiert, %@. Sonst geht nichts irgendwohin."
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung"
          }
        }
      }
    },
    "Sync Now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt synchronisieren"
          }
        }
      }
    },
    "Sync Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync-Token"
          }
        }
      }
    },
    "Sync failed, will retry": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagen, neuer Versuch folgt"
          }
        }
      }
    },
    "Sync is off: subscriptions, Watch Later, History and SponsorBlock settings stay on this Apple TV. To share them between the household's Apple TVs, run your own sync server and pass its URL and token to scripts/run-device.sh (see the README).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist aus: Abos, „Später ansehen“, Verlauf und SponsorBlock-Einstellungen bleiben auf diesem Apple TV. Um sie zwischen den Apple TVs des Haushalts zu teilen, betreibe deinen eigenen Sync-Server und übergib seine URL und sein Token an scripts/run-device.sh (siehe README)."
          }
        }
      }
    },
    "Sync is off: subscriptions, Watch Later, History and SponsorBlock settings stay on this device. To share them with the household's other devices, connect your own sync server below (see the README).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist aus: Abos, „Später ansehen“, Verlauf und SponsorBlock-Einstellungen bleiben auf diesem Gerät. Um sie mit den anderen Geräten des Haushalts zu teilen, verbinde unten deinen eigenen Sync-Server (siehe README)."
          }
        }
      }
    },
    "Sync is on: History is cleared on every Apple TV of the household.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist an: Der Verlauf wird auf jedem Apple TV des Haushalts gelöscht."
          }
        }
      }
    },
    "Sync is on: Watch Later is cleared on every Apple TV of the household.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist an: „Später ansehen“ wird auf jedem Apple TV des Haushalts geleert."
          }
        }
      }
    },
    "Synced %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert %@"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere …"
          }
        }
      }
    },
    "Syncs right away. FooTube also syncs when it opens, every 5 minutes while it's open, and a few seconds after each change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert sofort. FooTube synchronisiert außerdem beim Öffnen, alle 5 Minuten, solange es offen ist, und wenige Sekunden nach jeder Änderung."
          }
        }
      }
    },
    "Tangents and jokes that are not needed to understand the main content.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschweifungen und Witze, die man für den eigentlichen Inhalt nicht braucht."
          }
        }
      }
    },
    "The Keychain reported error %lld for the sync token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund meldet Fehler %lld für das Sync-Token."
          }
        }
      }
    },
    "The server answered with an error. Check the address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit einem Fehler geantwortet. Prüfe die Adresse."
          }
        }
      }
    },
    "The server rejected this token. Paste the sync token, not the inbox token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat dieses Token abgelehnt. Füge das Sync-Token ein, nicht das Inbox-Token."
          }
        }
      }
    },
    "The sync configuration couldn't be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sync-Konfiguration konnte nicht gelesen werden."
          }
        }
      }
    },
    "The sync server answered with an error. FooTube tries again at the next sync; the server's log (wrangler tail) has the details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync-Server hat mit einem Fehler geantwortet. FooTube versucht es bei der nächsten Synchronisierung erneut; Details stehen im Log des Servers (wrangler tail)."
          }
        }
      }
    },
    "The sync server can't be reached. Changes stay on this Apple TV and sync once it's back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync-Server ist nicht erreichbar. Änderungen bleiben auf diesem Apple TV und werden synchronisiert, sobald er wieder da ist."
          }
        }
      }
    },
    "The sync server can't be reached. Changes stay on this device and sync once it's back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync-Server ist nicht erreichbar. Änderungen bleiben auf diesem Gerät und werden synchronisiert, sobald er wieder da ist."
          }
        }
      }
    },
    "The sync server rejected this Apple TV's token. Run scripts/run-device.sh again with the server's current token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync-Server hat das Token dieses Apple TV abgelehnt. Führe scripts/run-device.sh erneut mit dem aktuellen Token des Servers aus."
          }
        }
      }
    },
    "The sync server rejected this device's token. Choose Change Server and paste the server's current sync token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sync-Server hat das Token dieses Geräts abgelehnt. Wähle „Server ändern“ und füge das aktuelle Sync-Token des Servers ein."
          }
        }
      }
    },
    "The token contains spaces or other characters a token can't have. Paste it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token enthält Leerzeichen oder andere Zeichen, die ein Token nicht haben kann. Füge es noch einmal ein."
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "This device stops syncing and forgets the server and its token. Subscriptions, Watch Later and History stay on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät synchronisiert nicht mehr und vergisst den Server und sein Token. Abos, „Später ansehen“ und Verlauf bleiben auf diesem Gerät."
          }
        }
      }
    },
    "This install stops launching on %@. Run scripts/run-device.sh again to renew it; subscriptions, history and Watch Later stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Installation startet ab %@ nicht mehr. Führe scripts/run-device.sh erneut aus, um sie zu verlängern; Abos, Verlauf und „Später ansehen“ bleiben erhalten."
          }
        }
      }
    },
    "This install stops launching on %@. Run scripts/run-ios-device.sh again to renew it; subscriptions, history and Watch Later stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Installation startet ab %@ nicht mehr. Führe scripts/run-ios-device.sh erneut aus, um sie zu verlängern; Abos, Verlauf und „Später ansehen“ bleiben erhalten."
          }
        }
      }
    },
    "This token has %lld characters; a sync token has at least %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Token hat %1$lld Zeichen; ein Sync-Token hat mindestens %2$lld."
          }
        }
      }
    },
    "This video has no format this Apple TV can play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video gibt es in keinem Format, das dieses Apple TV abspielen kann."
          }
        }
      }
    },
    "This video has no format this device can play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video gibt es in keinem Format, das dieses Gerät abspielen kann."
          }
        }
      }
    },
    "Token rejected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token abgelehnt"
          }
        }
      }
    },
    "Touch and hold a video and choose Add to Watch Later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Video gedrückt und füge es zu „Später ansehen“ hinzu."
          }
        }
      }
    },
    "Turn Off Sync": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung ausschalten"
          }
        }
      }
    },
    "Turn off sync?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung ausschalten?"
          }
        }
      }
    },
    "Unpaid self-promotion: merchandise, donations, or who the creator worked with.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbezahlte Eigenwerbung: Merchandise, Spenden oder mit wem der Creator zusammengearbeitet hat."
          }
        }
      }
    },
    "Unsubscribe": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abo beenden"
          }
        }
      }
