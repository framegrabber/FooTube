    "Up Next": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes"
          }
        }
      }
    },
    "Update FooTube on this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FooTube auf diesem Gerät aktualisieren"
          }
        }
      }
    },
    "Updated %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert %@"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "Videos you play appear here, most recent first, so you can pick up where you left off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, die du abspielst, erscheinen hier, die neuesten zuerst. So machst du dort weiter, wo du aufgehört hast."
          }
        }
      }
    },
    "Watch Later": {
      "localizations": {
