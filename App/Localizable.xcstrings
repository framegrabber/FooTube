{
  "sourceLanguage": "en",
  "strings": {
    "%@ skipped": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ übersprungen"
          }
        }
      }
    },
    "%@ watched": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gesehen"
          }
        }
      }
    },
    "%lld videos": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Videos"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld videos"
                }
              }
            }
          }
        }
      }
    },
    "A Skip button appears in the player while the segment plays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Abschnitt läuft, erscheint im Player eine Taste zum Überspringen."
          }
        }
      }
    },
    "A short reminder in the middle of the video to like, subscribe or follow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Erinnerung mitten im Video, zu liken, zu abonnieren oder zu folgen."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
    "Add to Watch Later": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu „Später ansehen“ hinzufügen"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle"
          }
        }
      }
    },
    "An interval without actual content: a pause, a static frame or a repeating animation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abschnitt ohne eigentlichen Inhalt: eine Pause, ein Standbild oder eine wiederholte Animation."
          }
        }
      }
    },
    "Another Apple TV saved data in a newer format. Install the current FooTube here; until then that data doesn't sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Apple TV hat Daten in einem neueren Format gespeichert. Installiere hier das aktuelle FooTube; bis dahin werden diese Daten nicht synchronisiert."
          }
        }
      }
    },
    "Another device saved data in a newer format. Install the current FooTube here; until then that data doesn't sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät hat Daten in einem neueren Format gespeichert. Installiere hier das aktuelle FooTube; bis dahin werden diese Daten nicht synchronisiert."
          }
        }
      }
    },
    "By default, sponsor segments are skipped automatically and every other category shows a Skip button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig werden Sponsor-Abschnitte automatisch übersprungen, alle anderen Kategorien zeigen eine Taste zum Überspringen."
          }
        }
      }
    },
    "Can't play this video: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video kann nicht abgespielt werden: %@"
          }
        }
      }
    },
    "Change Server…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server ändern …"
          }
        }
      }
    },
    "Channel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal"
          }
        }
      }
    },
    "Channels": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle"
          }
        }
      }
    },
    "Chapters": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapitel"
          }
        }
      }
    },
    "Clear Watch History": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf löschen"
          }
        }
      }
    },
    "Clear Watch Later": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Später ansehen“ leeren"
          }
        }
      }
    },
    "Clear Watch Later?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Später ansehen“ leeren?"
          }
        }
      }
    },
    "Clear watch history?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf löschen?"
          }
        }
      }
    },
    "Clearing removes every saved video from Watch Later. History and subscriptions stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle gespeicherten Videos aus „Später ansehen“. Verlauf und Abos bleiben erhalten."
          }
        }
      }
    },
    "Clearing removes every video from History, with its resume position and watched mark. Subscriptions and Watch Later stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Videos aus dem Verlauf, samt Wiedergabeposition und Gesehen-Markierung. Abos und „Später ansehen“ bleiben erhalten."
          }
        }
      }
    },
    "Clearing removes the videos with their resume positions and watched marks. Subscriptions stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Videos samt Wiedergabeposition und Gesehen-Markierung. Abos bleiben erhalten."
          }
        }
      }
    },
    "Clearing removes the videos with their resume positions and watched marks. Sync is on: they're cleared on every device of the household.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Videos samt Wiedergabeposition und Gesehen-Markierung. Die Synchronisierung ist an: Sie werden auf jedem Gerät des Haushalts gelöscht."
          }
        }
      }
    },
    "Clips that show what is coming up in this video or in other videos of a series.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschnitte, die zeigen, was in diesem Video oder in anderen Videos einer Reihe noch kommt."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden"
          }
        }
      }
    },
    "Couldn't load from YouTube: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden von YouTube fehlgeschlagen: %@"
          }
        }
      }
    },
    "Couldn't load this video: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video konnte nicht geladen werden: %@"
          }
        }
      }
    },
    "Couldn't reach the server. Check the address and the connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfe die Adresse und die Verbindung."
          }
        }
      }
    },
    "Couldn't reach the sync server. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync-Server nicht erreichbar. Versuche es später noch einmal."
          }
        }
      }
    },
    "Couldn't refresh the feed. Check the connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed konnte nicht aktualisiert werden. Prüfe die Verbindung und versuche es erneut."
          }
        }
      }
    },
    "Couldn't save Watch Later: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Später ansehen“ konnte nicht gespeichert werden: %@"
          }
        }
      }
    },
    "Couldn't save subscription: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abo konnte nicht gespeichert werden: %@"
          }
        }
      }
    },
    "Credits and end screens. Not conclusions that still carry information.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abspann und Endcards. Keine Schlussworte, die noch Inhalt haben."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Enter the server's address starting with https:// (http:// only for localhost).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Adresse des Servers mit https:// ein (http:// nur für localhost)."
          }
        }
      }
    },
    "Expires": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft ab"
          }
        }
      }
    },
    "Filler": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllmaterial"
          }
        }
      }
    },
    "Find videos and channels. Open a channel to subscribe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Videos und Kanäle. Öffne einen Kanal, um ihn zu abonnieren."
          }
        }
      }
    },
    "Finds the video streams on this Apple TV. github.com/alexeichhorn/YouTubeKit, MIT License.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die Videostreams auf diesem Apple TV. github.com/alexeichhorn/YouTubeKit, MIT-Lizenz."
          }
        }
      }
    },
    "Finds the video streams on this device. github.com/alexeichhorn/YouTubeKit, MIT License.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die Videostreams auf diesem Gerät. github.com/alexeichhorn/YouTubeKit, MIT-Lizenz."
